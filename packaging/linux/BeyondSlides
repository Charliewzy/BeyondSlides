#!/usr/bin/env bash
set -euo pipefail

application_directory=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
application="$application_directory/beyond-slides"
browser=${BEYOND_SLIDES_BROWSER_EXECUTABLE:-"$application_directory/chromium/ungoogled-chromium.AppImage"}
port=${BEYOND_SLIDES_PORT:-7842}

if [[ ! -x $application || ! -x $browser ]]; then
    echo "BeyondSlides is incomplete. Keep the executable and chromium directory beside this launcher." >&2
    exit 1
fi

if [[ -n ${BEYOND_SLIDES_DATA_DIR:-} ]]; then
    data_directory=$BEYOND_SLIDES_DATA_DIR
else
    data_home=${XDG_DATA_HOME:-${HOME:?HOME is not set}/.local/share}
    data_directory="$data_home/beyond-slides"
fi
mkdir -p "$data_directory"
controller_log="$data_directory/controller.log"

export BEYOND_SLIDES_RUNTIME_TOOLS_DIR="$application_directory/runtime-tools"
export BEYOND_SLIDES_BIND_ADDRESS=127.0.0.1
unset BEYOND_SLIDES_TRUSTED_ORIGINS

"$application" serve "$data_directory" "$port" >"$controller_log" 2>&1 &
server_pid=$!
browser_pid=

cleanup() {
    trap - EXIT INT TERM
    if [[ -n $browser_pid ]] && kill -0 "$browser_pid" 2>/dev/null; then
        kill -TERM "$browser_pid" 2>/dev/null || true
        wait "$browser_pid" 2>/dev/null || true
    fi
    if kill -0 "$server_pid" 2>/dev/null; then
        kill -INT "$server_pid" 2>/dev/null || true
        for _ in {1..50}; do
            kill -0 "$server_pid" 2>/dev/null || break
            sleep 0.1
        done
        if kill -0 "$server_pid" 2>/dev/null; then
            kill -TERM "$server_pid" 2>/dev/null || true
        fi
    fi
    wait "$server_pid" 2>/dev/null || true
}

run_browser() {
    "$@" &
    browser_pid=$!
    local status=0
    wait "$browser_pid" || status=$?
    browser_pid=
    return "$status"
}
trap cleanup EXIT
trap 'exit 130' INT TERM

ready=false
for _ in {1..100}; do
    if ! kill -0 "$server_pid" 2>/dev/null; then
        echo "BeyondSlides could not start. Diagnostic output:" >&2
        sed -n '1,160p' "$controller_log" >&2
        exit 1
    fi
    if (exec 3<>"/dev/tcp/127.0.0.1/$port") 2>/dev/null; then
        ready=true
        break
    fi
    sleep 0.1
done
if [[ $ready != true ]]; then
    echo "BeyondSlides did not become ready on port $port. See $controller_log." >&2
    exit 1
fi

url="http://127.0.0.1:$port"
browser_arguments=(
    "--app=$url"
    "--user-data-dir=$data_directory/.application-browser"
    --no-first-run
    --disable-default-apps
)
if [[ -n ${BEYOND_SLIDES_BROWSER_EXTRA_ARGS:-} ]]; then
    read -r -a extra_arguments <<<"$BEYOND_SLIDES_BROWSER_EXTRA_ARGS"
    browser_arguments+=("${extra_arguments[@]}")
fi

if ! run_browser "$browser" "${browser_arguments[@]}"; then
    echo "Portable Chromium could not mount directly; retrying in extract-and-run mode." >&2
    run_browser env APPIMAGE_EXTRACT_AND_RUN=1 "$browser" "${browser_arguments[@]}"
fi
