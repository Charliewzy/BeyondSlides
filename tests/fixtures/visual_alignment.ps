%%Page: 1 1
<< /PageSize [960 540] >> setpagedevice
1 setgray
0 0 960 540 rectfill
0 setgray
80 80 300 380 rectfill
/Helvetica-Bold findfont 64 scalefont setfont
460 270 moveto
(SLIDE ONE) show
showpage

%%Page: 2 2
<< /PageSize [960 540] >> setpagedevice
1 setgray
0 0 960 540 rectfill
0 setgray
580 80 300 380 rectfill
/Helvetica-Bold findfont 64 scalefont setfont
80 270 moveto
(SLIDE TWO) show
showpage

%%EOF
